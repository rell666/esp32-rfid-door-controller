#define MAX_MQTT_MESSAGE 4096
#define MQTT_QUEUE_MAX 16
#define MQTT_QUEUE_SLICE_MS 100 // time processMqttQueue() may spend per loop() pass
// All MQTT commands together, being assembled or queued (core::ByteBudget),
// as for the WebSocket: 16 full-size commands were 64 KB of heap.
#define MQTT_BYTES_MAX 12288

// Payloads are copied here by the MQTT client task and parsed in loop().
// Upstream reassembled them into a fixed 2 KB global buffer without a bounds
// check, so any broker client could overflow it with one large message.
struct MqttMessage
{
	std::string payload;
	size_t charged = 0;    // bytes held in mqttBudget, given back once processed
	uint64_t queuedAt = 0; // uptime ms
	uint32_t link = 0;     // mqttLink when queued
};
static core::ByteBudget mqttBudget(MQTT_BYTES_MAX);
std::deque<MqttMessage> mqttMessageQueue;
std::mutex mqttQueueMutex;
core::MessageAssembler mqttAssembler(MAX_MQTT_MESSAGE, &mqttBudget);
// Counts disconnects: a door command queued on an earlier connection is
// stale (core::mqttDoorCommandStale) and never runs after a reconnect.
static std::atomic<uint32_t> mqttLink{0};

static const char *applyConfigPolicy(JsonObject incoming);
static void userListLoop();
static void mqttConnectedLoop();
static void mqttDroppedLoop();

// Every publish goes through here: only while connected, and only while the
// client's outbox holds fewer than MQTT_OUTBOX_MAX messages, so a broker that
// stops reading cannot use up the heap (espMqttClient queues every publish
// and sends it from the TCP task; it also refuses with under 16 KB free).
// A refused message is counted; mqttDroppedLoop() logs the count.
#define MQTT_OUTBOX_MAX 48
static std::atomic<uint32_t> mqttDropped{0};

static bool mqttSend(const char *topic, bool retain, const char *payload)
{
	if (!mqttClient.connected())
		return false;
	if (mqttClient.queueSize() >= MQTT_OUTBOX_MAX || mqttClient.publish(topic, 0, retain, payload) == 0)
	{
		mqttDropped++;
		return false;
	}
	return true;
}

void publishDoorStates(); // door.esp
bool doorbellRinging();   // doorbell.esp
core::RelayBankView relayBank();

void connectToMqtt()
{
	if (!config.mqttEnabled || mqttClient.connected()) {
		return;
	}
#ifdef DEBUG
	Serial.println("[ INFO ] Connecting MQTT");
#endif
	mqttClient.connect();
}

void disconnectMqtt()
{
	if (!config.mqttEnabled || !mqttClient.connected()) {
		return;
	}
#ifdef DEBUG
	Serial.println("[ INFO ] Disconnecting MQTT");
#endif
	mqttClient.disconnect(true);
}

void onMqttDisconnect(espMqttClientTypes::DisconnectReason reason)
{
	String reasonstr = espMqttClientTypes::disconnectReasonToString(reason);
	mqttLink++;
	writeEvent("WARN", "mqtt", "Disconnected from MQTT server", reasonstr);

	// reconnect from loop() (see mqttLoop); this callback runs in the TCP task
	mqttRetryAtS.store((uint32_t)(uptimeMs() / 1000) + 60);
}

void mqttLoop()
{
	if (!config.mqttEnabled)
		return;
	mqttConnectedLoop();
	mqttDroppedLoop();
	// send what loop() queued now: left to the TCP task, a card waited for its
	// next poll (0.5-1.2 s to the broker, 0.35 s before; bench, ledger H30)
	if (mqttClient.connected())
		mqttClient.loop();
	userListLoop();
	if (mqttDisconnectRequested.exchange(false))
	{
		disconnectMqtt();
		// a got-IP that arrived in the same window keeps its connect request
		if (!mqttConnectRequested.load())
			mqttRetryAtS.store((uint32_t)(uptimeMs() / 1000) + 60);
	}
	if (!WiFi.isConnected() || mqttClient.connected())
		return;
	uint32_t retryAt = mqttRetryAtS.load();
	uint32_t nowS = (uint32_t)(uptimeMs() / 1000);
	if (mqttConnectRequested.exchange(false) || (retryAt != 0 && nowS >= retryAt))
	{
		mqttRetryAtS.store(nowS + 60); // next attempt if this one fails silently
		connectToMqtt();
	}
}

void mqttPublishEvent(JsonDocument *root, String topic)
{
	if (config.mqttEnabled && mqttClient.connected())
	{
		String stopic(config.mqttTopic);
		stopic = stopic + "/" + topic;
		String mqttBuffer;
		serializeJson(*root, mqttBuffer);
		mqttSend(stopic.c_str(), false, mqttBuffer.c_str());
#ifdef DEBUG
		Serial.print("[ INFO ] Mqtt Publish:");
		Serial.println(mqttBuffer);
#endif
	}
}

void mqttPublishEventHA(JsonDocument *root, String topic)
{
	if (config.mqttEnabled && mqttClient.connected())
	{
		String stopic = "homeassistant/";
		stopic = stopic + topic;
		String mqttBuffer;
		serializeJson(*root, mqttBuffer);
		mqttSend(stopic.c_str(), true, mqttBuffer.c_str());
#ifdef DEBUG
		Serial.print("[ INFO ] Mqtt Publish:");
		Serial.println(mqttBuffer);
#endif
	}
}

void mqttPublishEvent(JsonDocument *root)
{
	mqttPublishEvent(root, "send");
}

// Used by the log queue (already serialized in writeEvent). False if it was
// not sent (no broker connection): the caller writes it to the file instead.
bool mqttPublishRawEvent(const String &payload)
{
	if (!config.mqttEnabled || !mqttClient.connected())
		return false;
	String stopic(config.mqttTopic);
	stopic += "/send";
	return mqttSend(stopic.c_str(), false, payload.c_str());
}

// result false: the command failed (message says why); deletuid and
// deletusers used to answer as done whatever happened
void mqttPublishAck(String command, bool result = true, const char *message = nullptr)
{
	DynamicJsonDocument root(512);
	root["type"] = command;
	root["result"] = result;
	if (message)
		root["message"] = message;
	root["ip"] = WiFi.localIP().toString();
	root["hostname"] = config.deviceHostname;
	mqttPublishEvent(&root);
}

// An alarm on TOPIC/send whatever the event-log setting: with MQTT logging
// off, events go to the device's file only and nobody watching MQTT hears.
void mqttPublishAlarm(const char *src, const String &desc, const String &data)
{
	DynamicJsonDocument root(768);
	root["type"] = "alarm";
	root["src"] = src;
	root["desc"] = desc;
	root["data"] = data;
	root["time"] = deviceClock.epoch;
	root["hostname"] = config.deviceHostname;
	mqttPublishEvent(&root);
}

void mqttPublishBoot(time_t boot_time)
{
	DynamicJsonDocument root(512);
	root["type"] = "boot";
	root["time"] = boot_time;
	root["uptime"] = "0";
	root["ip"] = WiFi.localIP().toString();
	root["hostname"] = config.deviceHostname;
	mqttPublishEvent(&root);
}

// A Home Assistant sensor read from the card topic (<topic>/tag): Tag, User,
// Access, DoorName, Time differ only in these (review 7: discovery was one
// 161-line function).
static void haTagSensor(const String &deviceName, const String &mtopic, JsonDocument &via, const char *key, const char *name,
						const char *uniq, const char *tpl, const char *icon)
{
	DynamicJsonDocument d(512);
	String topic = "sensor/" + deviceName + "/" + key + "/config";
	d["name"] = name;
	d["uniq_id"] = deviceName + "/" + uniq;
	d["stat_t"] = mtopic + "/tag";
	d["avty_t"] = mtopic + "/avty";
	d["val_tpl"] = tpl;
	d["json_attr_t"] = mtopic + "/tag";
	d["icon"] = icon;
	d["dev"] = via;
	mqttPublishEventHA(&d, topic);
}

void mqttPublishDiscovery()
{
	String mtopic(config.mqttTopic);
	String topic;
	String deviceName = config.deviceHostname;
	String deviceIP = WiFi.localIP().toString();
	DynamicJsonDocument via(512);
	via["ids"] = WiFi.macAddress();

	DynamicJsonDocument dev(512);
	dev["ids"] = WiFi.macAddress();
	dev["name"] = config.deviceHostname;
	dev["mf"] = "esp-rfid";
	dev["sw"] = VERSION;
	String num;
	bool devSent = false;
	for (int n = 0; n < config.numRelays; n++)
	{
		DynamicJsonDocument root(512);
		num = String(n);
		topic = "lock/" + deviceName + "/lock" + num + "/config";
		if (!config.mqttDoorControl || config.relayPin[n] == 255)
		{
			// no lock entity (and no unlock payload) while MQTT door control
			// is off, or for a relay with no pin (nothing to lock); the empty
			// retained config removes one announced before
			if (mqttClient.connected())
				mqttSend(("homeassistant/" + topic).c_str(), true, "");
			continue;
		}
		root["name"] = deviceName + " Lock" + num;
		root["uniq_id"] = deviceName + "/lock" + num;
		root["stat_t"] = mtopic + "/io/lock" + num;
		root["cmd_t"] = mtopic + "/cmd";
		root["pl_unlk"] = "{cmd:'open', door:'" + num + "', doorip:'" + deviceIP + "'}";
		root["pl_lock"] = "{cmd:'close', door:'" + num + "', doorip:'" + deviceIP + "'}";
		root["avty_t"] = mtopic + "/avty";
		root["dev"] = devSent ? via : dev; // the full device once, on the first lock announced
		devSent = true;
		mqttPublishEventHA(&root, topic);
	}

	for (int i = 0; i < config.numRelays; i++)
	{
		if (config.doorPin[i] == 255)
			continue;
		// door 1 keeps upstream's ids and topics; door n adds its number
		String n = i == 0 ? String("") : String(i + 1);
		String label = config.doorName[i][0] ? String(config.doorName[i]) : (i == 0 ? String("Door") : "Door " + n);
		DynamicJsonDocument door(512);
		topic = "binary_sensor/" + deviceName + "/door" + n + "/config";
		door["name"] = label;
		door["uniq_id"] = deviceName + "/door" + n;
		door["stat_t"] = mtopic + "/io/door" + n;
		door["avty_t"] = mtopic + "/avty";
		door["dev_cla"] = "door";
		door["dev"] = via;
		mqttPublishEventHA(&door, topic);

		DynamicJsonDocument tamper(512);
		topic = "binary_sensor/" + deviceName + "/tamper" + n + "/config";
		tamper["name"] = label + " tamper";
		tamper["uniq_id"] = deviceName + "/tamper" + n;
		tamper["stat_t"] = mtopic + "/io/tamper" + n;
		tamper["avty_t"] = mtopic + "/avty";
		tamper["dev_cla"] = "safety";
		tamper["dev"] = via;
		mqttPublishEventHA(&tamper, topic);
	}

	if (config.doorbellpin != 255)
	{
		DynamicJsonDocument doorbell(512);
		topic = "binary_sensor/" + deviceName + "/doorbell/config";
		doorbell["name"] = "Doorbell";
		doorbell["uniq_id"] = deviceName + "/doorbell";
		doorbell["stat_t"] = mtopic + "/io/doorbell";
		doorbell["avty_t"] = mtopic + "/avty";
		doorbell["dev_cla"] = "sound";
		doorbell["icon"] = "mdi:bell";
		doorbell["dev"] = via;
		mqttPublishEventHA(&doorbell, topic);
	}

	haTagSensor(deviceName, mtopic, via, "tag", "Tag", "tag", "{{ value_json.uid }}", "mdi:key");

	haTagSensor(deviceName, mtopic, via, "user", "User", "name", "{{ value_json.username }}", "mdi:human");

	// Upstream's "PinCode" sensor showed every typed PIN in Home Assistant.
	// PINs are no longer published; an empty retained config removes the
	// entity a previous version created.
	if (config.mqttEnabled && mqttClient.connected())
		mqttSend(("homeassistant/sensor/" + deviceName + "/pincode/config").c_str(), true, "");

	haTagSensor(deviceName, mtopic, via, "access", "Access", "access", "{{ value_json.access }}", "mdi:lock-question");

	haTagSensor(deviceName, mtopic, via, "doorname", "DoorName", "doorname", "{{ value_json.doorName }}", "mdi:door");

	haTagSensor(deviceName, mtopic, via, "time", "Time", "time", "{{ value_json.time }}", "mdi:lock-clock");

	DynamicJsonDocument dellog(512);
	topic = "button/" + deviceName + "/dellog/config";
	dellog["name"] = deviceName + " Delete Log";
	dellog["uniq_id"] = deviceName + "/deletlog";
	dellog["cmd_t"] = mtopic + "/cmd";
	dellog["payload_press"] = "{cmd:'deletlog', doorip:'" + deviceIP + "'}";
	dellog["avty_t"] = mtopic + "/avty";
	dellog["dev"] = via;
	mqttPublishEventHA(&dellog, topic);
}

